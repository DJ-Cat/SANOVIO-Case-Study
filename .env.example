# Copy this file to .env and fill in what you have. Every key is optional:
# without one, that part of the platform falls back to a simple built-in
# stand-in, and the demo still opens with all its data (the AI results in it
# were computed once and are stored in the database).
#
# With the keys, new work is done live — choosing "Replace with this" runs a
# fresh AI analysis with web search, search understands meaning and other
# languages, and new uploads are matched automatically.

# Claude — replacement analysis (with web search), match verdicts.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Voyage — embeddings for semantic / cross-language search, and the reranker.
# https://dashboard.voyageai.com/
VOYAGE_API_KEY=

# OpenRouter — the Jev classifier that gates which pairs reach Claude.
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
